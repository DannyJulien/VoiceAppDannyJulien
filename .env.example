# Values with EXPO_PUBLIC_ are intentionally safe for the mobile client.
# Never prefix server-only credentials with EXPO_PUBLIC_.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server / Supabase Edge Function environment only. Do not copy these into the Expo client.
# Configure these as Supabase Edge Function Secrets, never in a public Expo variable.
SUPABASE_SERVICE_ROLE_KEY=
HANDLED_OPENAI_KEY=
OPENAI_ACTION_MODEL=gpt-4.1-mini
OPENAI_RESEARCH_MODEL=gpt-5.4
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
